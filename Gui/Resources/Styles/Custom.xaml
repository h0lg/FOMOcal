<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Style TargetType="Border" Class="RoundedSection" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="5" />
        <Setter Property="StrokeThickness" Value="5" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="SelectionMenu" ApplyToDerivedTypes="True">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10,10,0,0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="Error">
        <Setter Property="Padding" Value="2" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Border" Class="ScrapedValue">
        <Setter Property="Padding" Value="2" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Tertiary}}" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="3" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- style the selected item of the EventList CollectionView, see
        https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/collectionview/selection?view=net-maui-9.0#change-selected-item-color -->
    <Style TargetType="Border" Class="list-event">
        <Setter Property="Padding" Value="10" />
        <Setter Property="StrokeThickness" Value="0" />

        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <!-- fixes visual state on Android,
                                see https://github.com/dotnet/maui/issues/20062#issuecomment-1983143930
                                try removing after https://github.com/dotnet/maui/pull/31591 is merged -->
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- style the selected item of the EventList CollectionView, see
        https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/collectionview/selection?view=net-maui-9.0#change-selected-item-color -->
    <Style TargetType="SwipeView" Class="list-event">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <!-- fixes visual state on Android,
                                see https://github.com/dotnet/maui/issues/20062#issuecomment-1983143930
                                try removing after https://github.com/dotnet/maui/pull/31591 is merged -->
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButton}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryText}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style TargetType="Button" Class="stepper-btn">
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="32" />

        <Setter Property="Margin">
            <Setter.Value>
                <OnPlatform x:TypeArguments="Thickness" Default="-5,-11,-5,-10">
                    <On Platform="Android" Value="-5,-13,-5,-13" />
                </OnPlatform>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry" BasedOn="{StaticResource DefaultEntry}">
        <Setter Property="FontSize" Value="{OnIdiom 18, Desktop=14}" />
    </Style>

    <Style TargetType="Span">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
    </Style>

    <Style TargetType="Span" x:Key="Span.Link">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource LinkTextLight}, Dark={StaticResource LinkTextDark}}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

    <Style TargetType="Span" x:Key="Span.Highlit">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource HighlitTextLight}, Dark={StaticResource HighlitTextDark}}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style TargetType="Span" x:Key="Span.Help">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Help}, Dark={StaticResource HelpDark}}" />
    </Style>

    <Style TargetType="Span" x:Key="Span.HelpLink" BasedOn="{StaticResource Span.Link}">
    </Style>

    <Style TargetType="Span" x:Key="Span.HelpHeader" BasedOn="{StaticResource Span.Help}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Span" x:Key="Span.HelpFooter" BasedOn="{StaticResource Span.Help}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style TargetType="Border" Class="help">
        <Setter Property="Padding" Value="5" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource HelpBg}, Dark={StaticResource HelpBgDark}}" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="10" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label" Class="Headline" BasedOn="{StaticResource Headline}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style TargetType="Label" Class="SubHeadline" BasedOn="{StaticResource SubHeadline}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Label" x:Key="demotedLabel">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
    </Style>

    <Style TargetType="Label" Class="Demoted" BasedOn="{StaticResource demotedLabel}" />

    <Style TargetType="Label" Class="VenueRowDetail" BasedOn="{StaticResource demotedLabel}">
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style TargetType="Border" Class="EndingEntryButton">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        <Setter Property="Margin" Value="-4,0,0,0" />
        <Setter Property="StrokeThickness" Value="0" />

        <Setter Property="Padding">
            <Setter.Value>
                <OnPlatform x:TypeArguments="Thickness" Default="5,7,5,10">
                    <On Platform="Android" Value="5,3,5,4" />
                </OnPlatform>
            </Setter.Value>
        </Setter>

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="0,5,0,5" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Label" Class="EndingEntryButton">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style TargetType="Editor" x:Key="Editor.Error">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style TargetType="Editor" x:Key="Editor.Success">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
        <Setter Property="TextColor" Value="White" />
    </Style>

    <Style TargetType="Picker" BasedOn="{StaticResource DefaultPicker}">
        <Setter Property="FontSize" Value="{OnIdiom 18, Desktop=14}" />
    </Style>

    <Style TargetType="ProgressBar" BasedOn="{StaticResource DefaultProgressBar}">
        <Setter Property="ProgressColor" Value="{AppThemeBinding Light={StaticResource Success}, Dark={StaticResource SuccessDark}}" />
    </Style>

    <!--see https://learn.microsoft.com/en-us/dotnet/maui/user-interface/controls/radiobutton?view=net-maui-9.0#redefine-radiobutton-appearance-->
    <ControlTemplate x:Key="SingleSelectToggleButtonTemplate">
        <Border Padding="10,0" StrokeThickness="0" StrokeShape="RoundRectangle 10">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CheckedStates">
                        <VisualState x:Name="Checked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Unchecked">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="Transparent"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter VerticalOptions="Center" />
        </Border>
    </ControlTemplate>

    <Style TargetType="RadioButton" Class="SingleSelectToggleButton">
        <Setter Property="ControlTemplate" Value="{StaticResource SingleSelectToggleButtonTemplate}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True" BasedOn="{StaticResource DefaultShell}">
        <Setter Property="Shell.TabBarBackgroundColor" Value="{AppThemeBinding Light={StaticResource LightSecondaryBackground}, Dark={StaticResource DarkSecondaryBackground}}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource Primary}}" />
    </Style>

    <Style TargetType="Grid" Class="VisualSelector">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />

        <!-- initialize it collapsed and prepared for opening HeightRequest animation -->
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="HeightRequest" Value="0" />
    </Style>

    <Style TargetType="Grid" Class="VisualSelectorContent">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}" />
    </Style>
</ResourceDictionary>
